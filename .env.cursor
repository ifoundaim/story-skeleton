############################################################
# .env.cursor  –  committed version for AI tools
# Contains **dummy** secrets but preserves variable names,
# shapes, and comments so Cursor can reason about them.
############################################################

########## Database ########################################
# Inside Docker, “db” is the hostname; keep identical.
POSTGRES_URL=postgresql://postgres:pass@db:5432/purposepath

# pgvector remains enabled for embeddings
PGVECTOR_EXTENSION=true

########## Object-storage / uploads ########################
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=purposepath-assets
S3_ACCESS_KEY=DUMMY_ACCESS_KEY          # ← redacted
S3_SECRET_KEY=DUMMY_SECRET_KEY          # ← redacted

########## OpenAI / embeddings #############################
OPENAI_API_KEY=DUMMY_OPENAI_KEY         # ← redacted
EMBED_MODEL=text-embedding-3-small      # keep default

########## Auth ############################################
JWT_SECRET=DUMMY_JWT_SECRET             # ← redacted

########## Development flags ###############################
USE_CPU_STUBS=true
